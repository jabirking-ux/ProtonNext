# .gitignore for ProtonNext

# Visual Studio / MSBuild
.vs/
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Python
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
venv/
ENV/
env/

# Logs & temp
*.log
*.tmp
*.bak
.freebuff/

# Installer output
*.Setup.exe
installer/Output/
installer/*.exe

# Retain essential compiled helper engine binaries
!ProtonVPN-Next-CLI/engine/pvpn-engine.exe
!ProtonVPN-Next-CLI/engine/wintun.dll
